// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// RealEstateManager - Core Data Model
// Designed for individual landlords (1-10 properties)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Relations
  properties Property[]
  tenants    Tenant[]
  leases     Lease[]

  // Auth.js adapter fields
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Property Management
// ============================================

model Property {
  id            String   @id @default(cuid())
  userId        String
  name          String
  address       String
  city          String
  state         String
  zip           String
  propertyType  String   // SingleFamily, MultiFamily, Apartment, Condo, Commercial, etc.
  bedrooms      Int?
  bathrooms     Float?
  squareFeet    Int?
  yearBuilt     Int?
  description   String?  @db.Text
  photos        String[] // Array of image URLs

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  units  Unit[]
  leases Lease[]

  maintenanceRequests MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Unit {
  id          String  @id @default(cuid())
  propertyId  String
  unitNumber  String? // e.g. "Apt 2B", "Unit 1"
  bedrooms    Int?
  bathrooms   Float?
  squareFeet  Int?
  rentAmount  Decimal? @db.Decimal(10, 2)
  isOccupied  Boolean  @default(false)
  notes       String?  @db.Text

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   Lease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

// ============================================
// Tenants & Leases
// ============================================

model Tenant {
  id          String   @id @default(cuid())
  userId      String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  notes       String?  @db.Text

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leases Lease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Lease {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  unitId     String?
  tenantId   String

  rentAmount   Decimal  @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime
  status       String   @default("Active") // Active, Expired, Pending, Terminated
  paymentDay   Int?     // Day of month rent is due (1-31)
  securityDeposit Decimal? @db.Decimal(10, 2)

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments           Payment[]
  maintenanceRequests MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
}

// ============================================
// Financials
// ============================================

model Payment {
  id        String   @id @default(cuid())
  leaseId   String
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime
  method    String?  // Cash, Check, BankTransfer, Venmo, Zelle, etc.
  status    String   @default("Paid") // Paid, Pending, Failed, Refunded
  notes     String?  @db.Text

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leaseId])
  @@index([paidAt])
}

// ============================================
// Maintenance
// ============================================

model MaintenanceRequest {
  id          String   @id @default(cuid())
  propertyId  String
  leaseId     String?
  title       String
  description String   @db.Text
  priority    String   @default("Medium") // Low, Medium, High, Emergency
  status      String   @default("Open")   // Open, InProgress, Completed, Cancelled
  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)
  completedAt   DateTime?

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lease    Lease?   @relation(fields: [leaseId], references: [id])

  // Future: photos, comments, assignedTo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([priority])
}

