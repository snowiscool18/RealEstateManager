# RealEstateManager .gitignore

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build outputs and dependencies
node_modules/
dist/
build/
out/
*.exe
*.dll
*.so
*.dylib
bin/
obj/

# Logs and databases
*.log
logs/
*.sqlite
*.db
*.db-journal

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# Package managers
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.lock

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak

# Test coverage
coverage/
.nyc_output/

# Misc
*.tgz
*.tar.gz
*.zip
